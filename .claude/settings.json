{
  "alwaysThinkingEnabled": false,
  "autoMemoryEnabled": true,
  "enabledPlugins": {
    "oh-my-claudecode@omc": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npx:*)",
      "Bash(git:* --no-pager)",
      "Bash(git:status*)",
      "Bash(git:diff*)",
      "Bash(git:log*)",
      "Bash(git:branch*)",
      "Bash(git:add*)",
      "Bash(git:commit*)",
      "Bash(git:push*)",
      "Bash(git:pull*)",
      "Bash(git:remote:*)",
      "Bash(npx tsx:*)",
      "Bash(npx vitest:*)",
      "Bash(tsc:*)",
      "Bash(vite:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(sort:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(node:dist/src/main.js:*)",
      "Bash(curl:localhost:*)",
      "Bash(curl:127.0.0.1:*)",
      "Bash(sleep:*)",
      "Agent",
      "WebSearch",
      "WebFetch",
      "LSP",
      "Skill",
      "TodoWrite",
      "NotebookEdit",
      "AskUserQuestion"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(curl:!local:*)",
      "Bash(curl:!localhost:*)",
      "Bash(curl:!127.0.0.1:*)",
      "Bash(wget:*)",
      "Bash(> /dev:*)",
      "Bash(> /etc:*)",
      "Bash(sudo:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "env": {
    "OPENCLI_DAEMON_PORT": "19825",
    "OPENCLI_VERBOSE": "false"
  }
}
